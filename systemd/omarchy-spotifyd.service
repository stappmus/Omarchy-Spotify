[Unit]
Description=Lightweight Spotify playback engine for Omarchy Spotify
Documentation=https://github.com/Spotifyd/spotifyd
After=graphical-session.target sound.target omarchy-spotify-bluetooth-recovery.service
Wants=sound.target omarchy-spotify-bluetooth-recovery.service
Conflicts=omarchy-spotify.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# librespot's PulseAudio backend accepts the server default buffer unless the
# client latency is constrained. Keep manual track changes responsive without
# bypassing PipeWire's selected output or speaker-tuning filters.
Environment=PULSE_LATENCY_MSEC=30
ExecStart=/usr/bin/spotifyd --no-daemon --config-path=%h/.config/omarchy-spotify/spotifyd.conf
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
