[Unit]
Description=Omarchy Spotify plugin playback backend
Documentation=https://github.com/stappmus/QuickshellSpotify
After=graphical-session.target sound.target omarchy-spotify-bluetooth-recovery.service
Wants=sound.target omarchy-spotify-bluetooth-recovery.service
Conflicts=omarchy-spotifyd.service

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
Environment=TOKIO_WORKER_THREADS=2
ExecStart=%h/.local/lib/omarchy-spotify/omarchy-spotify-backend --config-path=%h/.config/omarchy-spotify/spotifyd.conf
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=75 77 78
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
